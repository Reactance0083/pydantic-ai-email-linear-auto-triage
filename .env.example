# Anthropic API Key
# Get it from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Linear API Key
# Get it from: https://linear.app/settings/account/api
LINEAR_API_KEY=your_linear_api_key_here

# Linear Team ID
# Get it from: https://linear.app/settings/account (under Workspace section) or from any Linear issue URL
LINEAR_TEAM_ID=your_linear_team_id_here

# Email Configuration - SMTP Server Settings
# SMTP server for receiving/monitoring emails (e.g., gmail, outlook, etc.)
EMAIL_SMTP_SERVER=imap.gmail.com
EMAIL_SMTP_PORT=993

# Email Account Credentials
# The email address to monitor for incoming issues
EMAIL_ADDRESS=your_email@gmail.com

# Email Account Password
# For Gmail: Use an App-specific password (https://myaccount.google.com/apppasswords)
# For other providers: Use your email password
EMAIL_PASSWORD=your_email_password_here

# Optional: Email folder to monitor (default: INBOX)
EMAIL_FOLDER=INBOX

# Linear Workspace URL
# Get it from your Linear workspace settings (e.g., https://linear.app/workspace-name)
LINEAR_WORKSPACE_URL=https://linear.app/your-workspace

# Pydantic AI Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# FastAPI Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Email Check Interval (in seconds)
EMAIL_CHECK_INTERVAL=300

# Optional: Default Linear Assignee ID
# If not specified, issues will be unassigned
# LINEAR_DEFAULT_ASSIGNEE_ID=your_user_id_here

# Optional: Default Linear Project ID for issues
# If not specified, will use team default
# LINEAR_PROJECT_ID=your_project_id_here